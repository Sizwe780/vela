VELA_SUPPORT_OPERATOR_ID=""
# OAuth providers already configured in Neon Auth, e.g. google,microsoft.
VELA_SSO_PROVIDERS=""
# Private content-factory volume and model. Defaults keep extraction and regeneration local.
CONTENT_FACTORY_EVIDENCE_DIR=""
CONTENT_FACTORY_MODEL=""
CONTENT_FACTORY_REGEN_PROVIDER="ollama"
NEON_FUNCTION_HELLO_BASE_URL=""
NEON_REALTIME_URL=""
NEON_REALTIME_SECRET=""
# Gateway is pending on the Free plan; these are populated after paid activation.
NEON_AI_GATEWAY_BASE_URL=""
NEON_AI_GATEWAY_TOKEN=""
OPENAI_API_KEY=""
AI_PROVIDER="cloudflare"
OPENAI_BASE_URL="http://localhost:11434/v1"
CHAT_MODEL="llama3.2:3b"
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_CHAT_MODEL="openai/gpt-oss-120b"
GEMINI_API_KEY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
GEMINI_CHAT_MODEL="gemini-3.1-flash-lite"
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_CHAT_MODEL="openrouter/free"
OLLAMA_CHAT_MODEL="llama3.2:3b"
OLLAMA_GUIDED_MODEL="llama3.2:3b"
# For a second laptop running Ollama on your LAN, set this to its IP address.
# Example: http://192.168.1.42:11434/v1
OLLAMA_BASE_URL="http://localhost:11434/v1"
EMBEDDING_MODEL="nomic-embed-text"
EMBEDDING_DIMENSIONS="768"
# Browser login for local development: npm run cloudflare:login
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_AUTH_MODE="wrangler"
CLOUDFLARE_CHAT_MODEL="@cf/mistralai/mistral-small-3.1-24b-instruct"
CLOUDFLARE_QUIZ_MODEL="@cf/meta/llama-3.3-70b-instruct-fp8-fast"
# Hosted deployments use a Workers AI API token instead of the local Wrangler CLI.
CLOUDFLARE_API_TOKEN=""
# Generate a strong random value and send as Authorization: Bearer <value>.
INGEST_API_TOKEN=""
# Directory containing the two supplied MAT1512 PDFs (server-side only).
MAT1512_SOURCE_DIR=""

# Optional local Marker/Surya runtime overrides (server/CLI only).
MARKER_EXECUTABLE=""
LLAMA_CPP_BINARY=""
SURYA_GGUF_LOCAL_MODEL_PATH=""
SURYA_GGUF_LOCAL_MMPROJ_PATH=""

# Public launch configuration. Leave policies unapproved until operator review.
NEXT_PUBLIC_SITE_URL="http://localhost:3200"
POLICIES_APPROVED="false"

# Free transactional mail. Start with test mode and your verified own inbox.
EMAIL_MODE="disabled"
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
BREVO_API_KEY=""
EMAIL_FROM=""
EMAIL_REPLY_TO="sizwe.ngwenya78@gmail.com"
EMAIL_TEST_RECIPIENT="sizwe.ngwenya78@gmail.com"
EMAIL_APP_URL="http://localhost:3200"
EMAIL_DAILY_LIMIT="85"
# Generate independent random secrets, at least 32 characters each. Never expose to clients.
EMAIL_UNSUBSCRIBE_SECRET=""
EMAIL_JOB_SECRET=""

