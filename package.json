{
  "name": "modular-lms-schema",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --generator appClient && node scripts/prepare-build.mjs && node scripts/build-offline.mjs && next build --webpack",
    "start": "next start",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:neon": "node scripts/verify-neon.mjs",
    "test:quiz:live": "tsx scripts/verify-quiz.ts",
    "test:mat1512": "tsx scripts/verify-mat1512.ts",
    "ingest:mat1512": "tsx scripts/ingest-mat1512.ts",
    "audit:mat1512": "tsx scripts/audit-mat1512.ts",
    "ai:check": "tsx scripts/check-ai.ts",
    "cloudflare:login": "node scripts/cloudflare-login.mjs",
    "ollama:serve": "node scripts/ollama-local.mjs serve",
    "ollama:pull": "node scripts/ollama-local.mjs pull",
    "generate": "prisma generate",
    "validate": "prisma validate",
    "typecheck": "tsc --noEmit",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:sessions": "node --require ./scripts/windows-runtime.cjs --import tsx scripts/seed-sessions.ts",
    "db:setup": "npm run generate && npm run db:deploy && npm run db:seed",
    "curriculum:register": "tsx prisma/register-study-unit.ts",
    "verify": "tsx prisma/verify.ts",
    "parse:math": "tsx scripts/parse-math-pdf.ts",
    "ingest:structured": "tsx scripts/ingest-structured.ts",
    "test:math": "tsx scripts/verify-math.ts",
    "bulk:convert": "node --require ./scripts/windows-runtime.cjs --import tsx scripts/bulk-convert.ts",
    "bulk:start": "node --require ./scripts/windows-runtime.cjs --import tsx scripts/bulk-control.ts start",
    "bulk:status": "node --require ./scripts/windows-runtime.cjs --import tsx scripts/bulk-control.ts status",
    "bulk:watch": "node scripts/watch-bulk.mjs",
    "bulk:pause": "node --require ./scripts/windows-runtime.cjs --import tsx scripts/bulk-control.ts pause",
    "bulk:resume": "node --require ./scripts/windows-runtime.cjs --import tsx scripts/bulk-control.ts resume",
    "benchmark:math": "node --import tsx scripts/benchmark-math.ts",
    "audit:conversion": "node --require ./scripts/windows-runtime.cjs --import tsx scripts/audit-complete-conversion.ts",
    "audit:masterclasses": "node --require ./scripts/windows-runtime.cjs --import tsx scripts/audit-masterclasses.ts",
    "mat1503:register": "node --require ./scripts/windows-runtime.cjs --import tsx scripts/register-mat1503.ts",
    "mat1503:publish": "node --require ./scripts/windows-runtime.cjs --import tsx scripts/publish-mat1503.ts",
    "mat1503:index": "node --require ./scripts/windows-runtime.cjs --import tsx scripts/index-module-lessons.ts --module=MAT1503",
    "mat1503:convert": "node --require ./scripts/windows-runtime.cjs --import tsx scripts/convert-module.ts --module=MAT1503",
    "mat1503:audit": "node --require ./scripts/windows-runtime.cjs --import tsx scripts/publish-mat1503.ts --audit-only",
    "mat1503:watch": "node scripts/watch-module-conversion.mjs --module=MAT1503",
    "mat1503:status": "node scripts/watch-module-conversion.mjs --module=MAT1503 --once",
    "mat1503:pause": "node scripts/pause-module-conversion.mjs --module=MAT1503",
    "chemistry:stage": "node --require ./scripts/windows-runtime.cjs --import tsx scripts/stage-che1501.ts",
    "chemistry:remap": "node --require ./scripts/windows-runtime.cjs --import tsx scripts/remap-che1501-sequential.ts",
    "bpt1501:stage": "node --require ./scripts/windows-runtime.cjs --import tsx scripts/stage-bpt1501.ts",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx,css}\" \"lib/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx,css}\" \"lib/**/*.{ts,tsx}\"",
    "audit:visuals": "node --require ./scripts/windows-runtime.cjs --import tsx scripts/audit-lesson-visuals.ts",
    "audit:modules": "node --require ./scripts/windows-runtime.cjs --import tsx scripts/audit-module-readiness.ts",
    "email:worker": "node --require ./scripts/windows-runtime.cjs --import tsx scripts/email-worker.ts",
    "email:once": "node --require ./scripts/windows-runtime.cjs --import tsx scripts/email-worker.ts --once",
    "email:status": "node --require ./scripts/windows-runtime.cjs --import tsx scripts/email-status.ts",
    "email:test": "node --require ./scripts/windows-runtime.cjs --import tsx scripts/email-send-test.ts",
    "content:verify": "node --require ./scripts/windows-runtime.cjs --import tsx scripts/verify-content.ts",
    "content:ocr": "node --require ./scripts/windows-runtime.cjs --import tsx scripts/content-ocr.ts",
    "content:batch": "node --require ./scripts/windows-runtime.cjs --import tsx scripts/content-batch.ts",
    "content:generate": "node --require ./scripts/windows-runtime.cjs --import tsx scripts/generate-sessions.ts",
    "predev": "node scripts/build-offline.mjs",
    "prebuild": "node scripts/prepare-math-assets.mjs && node scripts/prepare-coach-worker.mjs",
    "pretest": "node scripts/prepare-coach-worker.mjs",
    "offline:build": "node scripts/build-offline.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.137",
    "@ai-sdk/react": "3.0.326",
    "@neon/auth": "^0.8.2",
    "@neon/config": "^1.11.3",
    "@neon/env": "^1.6.15",
    "@neon/functions": "^0.11.0",
    "@neon/realtime": "^0.2.0",
    "@neon/realtime-react": "^0.2.0",
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "6.19.0",
    "ai": "6.0.323",
    "dotenv": "16.6.1",
    "jose": "^6.2.15",
    "js-tiktoken": "1.0.21",
    "katex": "0.16.47",
    "mathlive": "0.111.4",
    "nerdamer": "2.0.1",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "server-only": "0.0.1",
    "unified": "11.0.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-pgvector": "0.0.16",
    "@playwright/test": "1.64.1",
    "@types/katex": "^0.16.8",
    "@types/node": "22.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.25.12",
    "prettier": "^3.10.1",
    "prisma": "6.19.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "wrangler": "^4.158.0"
  }
}
